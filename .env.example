# Local development settings for docker compose. Never commit a real .env file.
# Append a security key with: echo "CRAFT_SECURITY_KEY=$(openssl rand -hex 32)" >> .env

CRAFT_APP_ID=craft-local
CRAFT_ENVIRONMENT=dev
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_RUN_QUEUE_AUTOMATICALLY=true
PRIMARY_SITE_URL=http://localhost:8080

DB_HOST=postgres
DB_PORT=5432
DB_NAME=craft
DB_USER=craft
DB_PASS=local-dev-only
